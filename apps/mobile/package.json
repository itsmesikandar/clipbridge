{
  "name": "@clipbridge/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "ClipBridge mobile app (Android, iOS).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "doctor": "expo-doctor",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@clipbridge/app": "workspace:*",
    "@clipbridge/core": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-share-intent": "^8.0.1",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "react-native-zeroconf": "^0.17.4"
  },
  "devDependencies": {
    "@clipbridge/eslint-config": "workspace:*",
    "@clipbridge/tsconfig": "workspace:*",
    "@react-native/metro-config": "0.86.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "eslint": "10.12.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.{ts,tsx}"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@noble))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}
