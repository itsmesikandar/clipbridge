{
  "name": "@clipbridge/test-utils",
  "version": "0.0.0",
  "private": true,
  "description": "Test doubles and fixtures for @clipbridge/core (in-memory network, fake clock, ...).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@clipbridge/core": "workspace:*"
  },
  "devDependencies": {
    "@clipbridge/eslint-config": "workspace:*",
    "@clipbridge/tsconfig": "workspace:*",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
